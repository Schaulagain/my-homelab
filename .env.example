# Copy to .env and fill in. .env is git-ignored — never commit real passwords.
TZ=Asia/Kathmandu

# Pi-hole web admin password
PIHOLE_PASSWORD=change-me

# Jellyfin runs as this user (find yours with: id -u && id -g)
PUID=1000
PGID=1000

# Folder on the server that holds your movies/shows/music
MEDIA_PATH=/srv/media
